{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/drizzle/meta",
      "!designs",
      "!walkthrough/mods",
      "!.claude/worktrees"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": { "enabled": true },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always" } },
  "overrides": [
    {
      "includes": [
        "src/**",
        "!src/app/client.ts",
        "!src/app/sentry.ts",
        "!src/browser/session.ts",
        "!src/share/fetch.ts",
        "!src/calls/obs.ts",
        "!src/mail/imap.ts",
        "!src/mail/session.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@restatedev/restate-sdk-clients": "One door per vendor: import src/app/client.ts.",
                  "@sentry/node": "One door per vendor: import src/app/sentry.ts.",
                  "patchright": "One door per vendor: import src/browser/session.ts.",
                  "undici": "One door per vendor: import src/share/fetch.ts.",
                  "obs-websocket-js": "One door per vendor: import src/calls/obs.ts.",
                  "imapflow": "One door per vendor: import src/mail/imap.ts and src/mail/session.ts."
                }
              }
            }
          }
        }
      }
    }
  ]
}
