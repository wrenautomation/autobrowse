# Hack the North 2026 demo config. Copy to .env, fill the keys. Prod keeps .env.example.
BROWSER=browserbase
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSER_HEADLESS=false
# demo speed: no human pacing
PACE=fast
GUARDS=purchase
# the evaluator proposes workflows every 3 minutes on stage
EVALUATE_EVERY_HOURS=0.05
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-5
MEMORY=backboard
BACKBOARD_API_KEY=
BACKBOARD_ASSISTANT=autobrowse-htn
LINQ_API_KEY=
LINQ_NUMBER=
LINQ_TO=
LINQ_WEBHOOK_SECRET=
SENTRY_DSN=
SENTRY_ENVIRONMENT=htn-2026
RESTATE_INGRESS_URL=http://127.0.0.1:8080
UI_PORT=9080
