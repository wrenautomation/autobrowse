# Never committed with values. Names only.
RESTATE_INGRESS_URL=
RESTATE_AUTH_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
GOOGLE_SERVICE_ACCOUNT=~/.config/wren/wren-sender.json
GOOGLE_ADMIN_USER=
ROSTER_SSM_PARAM=/wren/prod/senders_config
AWS_REGION=us-east-1
NOTIFY_TO=
NOTIFY_FROM=
DMARC_RUA=
GITHUB_TOKEN=
WREN_REPO=wrenautomation/wren
BROWSER=local
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
PROFILES_DIR=~/.config/autobrowse/profiles
ARTIFACTS_DIR=~/.config/autobrowse/artifacts
RECORDINGS_DIR=recordings
LOG_LEVEL=info
RESTATE_PORT=9081
# Local browser: chrome (installed Google Chrome; what a person's login looks like) or chromium.
BROWSER_CHANNEL=chrome
# Value at boot; the UI header button / PUT /api/settings flips it live. false on a laptop
# worker when a site's bot check wants a window; `--headed` on a command shows just that one.
BROWSER_HEADLESS=true
# human (default: acts paced like a person, which sites expect) or fast (demos, tests).
PACE=human
UI_PORT=9080
# Bind address for the UI; unset = loopback without UI_TOKEN. Compose sets 0.0.0.0.
UI_HOST=
UI_TOKEN=
# Guards a person still approves: all (default), none, or a comma list of purchase, password, irreversible.
GUARDS=all
# Sentry: failed runs, failed steps and crashes become issues, tagged workflow/key/step. Off when unset.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
# Every N hours the evaluator reads failures, sessions and recordings and messages what deserves a workflow; 0 = off.
EVALUATE_EVERY_HOURS=0
# On EC2 only: stop the machine after N idle minutes (no run, flow, site call, agent session or UI request); 0 = never.
IDLE_STOP_MINUTES=0
# Let those proposals be explored, saved and compiled with nobody clicking (guards still hold).
AUTO_BUILD=false
# A compiled step that fails: the agent finishes it on the page, the step is rewritten from what it did, and the flow is proven again.
AUTO_HEAL=false
# Where minted credentials go: envfile (this file, upserted) or ssm (the env store, /autobrowse/config/<NAME>; `autobrowse env` reads and writes it).
SECRET_SINK=envfile
ENV_FILE=.env
# Site credentials for automated sign-in (0600 JSON; `autobrowse creds set <site>` writes it).
# In a container, AUTOBROWSE_CRED_<SITE>_USERNAME / _PASSWORD / _TOTP_SECRET from a Secret are read first.
CREDENTIALS_FILE=~/.config/autobrowse/credentials.json
# A value the recorder redacted in a compiled flow (say `cardCvv`) is read at run time from AUTOBROWSE_CARD_CVV.
# keychain (macOS: AES-256-GCM, key in the login Keychain) or none (containers: credentials from env).
CREDENTIALS_CIPHER=
# Inbox that receives email one-time codes when the credential does not name one.
CODES_INBOX=
# Linq (iMessage from a number we own, no Mac): key + our number; LINQ_TO = the operator (defaults to PHONE_NUMBER).
# Register a webhook at <UI>/hooks/linq for message.received and put its signing secret here.
LINQ_API_KEY=
LINQ_NUMBER=
LINQ_TO=
LINQ_WEBHOOK_SECRET=
# SMS one-time codes: a Twilio number we own. All three or none.
# A personal phone paired with this Mac (E.164). SMS codes are read from Messages'
# database (Text Message Forwarding on, Full Disk Access for the terminal app), notes
# go back over iMessage. `autobrowse setup` checks both and opens the pane.
# Which of your accounts is for what, for a box with no ~/.config/autobrowse/accounts.json (`autobrowse accounts push` writes it).
AUTOBROWSE_ACCOUNTS=
# The Workspace domain the service account is delegated for: those inboxes read codes without a consent.
GOOGLE_WORKSPACE_DOMAIN=
PHONE_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
# Per-site credentials as env (a k8s Secret; also fine in this file). Site names uppercased, dashes to underscores.
AUTOBROWSE_CRED_CLOUDFLARE_USERNAME=
AUTOBROWSE_CRED_CLOUDFLARE_PASSWORD=
AUTOBROWSE_CRED_CLOUDFLARE_TOTP_SECRET=
AUTOBROWSE_CRED_GOOGLE_ADMIN_USERNAME=
AUTOBROWSE_CRED_GOOGLE_ADMIN_PASSWORD=
AUTOBROWSE_CRED_GOOGLE_ADMIN_TOTP_SECRET=
WEBHOOK_URL=
WEBHOOK_TOKEN=
# anthropic | openai (key below) | claude-code (headless `claude -p` on your subscription, no key)
LLM_PROVIDER=anthropic
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Tokens (in + out) all model calls may spend per UTC day, worker and CLI together; 0 = no cap.
LLM_DAILY_TOKENS=3000000
MEMORY=none
BACKBOARD_API_KEY=
BACKBOARD_ASSISTANT=autobrowse
RESTATE_ADMIN_URL=
RESTATE_ENDPOINT_URL=
# Restate Cloud with no inbound port: the worker dials the env's tunnel and registers the URL it gets.
# All four together (RESTATE_AUTH_TOKEN is the Full-role key). RESTATE_IDENTITY_KEY alone also locks a plain listener to one env.
RESTATE_TUNNEL_NAME=
RESTATE_ENVIRONMENT_ID=
RESTATE_CLOUD_REGION=
RESTATE_IDENTITY_KEY=
