# autobrowse settings. Copy to .env; never commit it with values.
# Every key is optional: an empty .env runs tier 0. Uncomment a key to change it.
# Operator and fleet settings (DNS, rosters, SMS numbers, Restate Cloud): deploy/operator.env.example.

# ── Tier 0: explore a public page, compile, replay. Needs npx + Chromium. No keys. ─────────

# Local browser: chrome (installed Google Chrome; what a person's login looks like) or chromium.
# BROWSER_CHANNEL=chrome
# Value at boot; the UI header button flips it live. `--headed` on a command shows just that one.
# BROWSER_HEADLESS=true
# human (acts paced like a person, which sites expect) or fast (demos, tests).
# PACE=human
# PROFILES_DIR=~/.config/autobrowse/profiles
# ARTIFACTS_DIR=~/.config/autobrowse/artifacts
# RECORDINGS_DIR=recordings
# Locator fixes the repairer found; tried first next run until the flow source changes (`autobrowse repairs`).
# FIXES_FILE=~/.config/autobrowse/fixes.json
# Flows to watch step by step (all, a site, or site/flow, comma separated): a masked shot + aria per step.
# WATCH_FLOWS=
# LOG_LEVEL=info
# UI_PORT=9080
# UI_HOST=127.0.0.1
# UI_TOKEN=
# Scrubbed traces and passed flows go to the shared library. Off: AUTOBROWSE_SHARE=off (or DO_NOT_TRACK=1).
# AUTOBROWSE_SHARE=off

# ── Tier 1: the agent, `do`, and your own signed-in accounts. ──────────────────────────────

# claude-code (headless `claude -p` on your subscription, no key) | anthropic | openai (key below).
# LLM_PROVIDER=claude-code
# LLM_MODEL=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# The model that looks at captcha pictures; unset = the main model.
# EYES_PROVIDER=
# EYES_MODEL=
# Tokens (in + out) all model calls may spend per UTC day; 0 = no cap.
# LLM_DAILY_TOKENS=3000000
# Site credentials for automated sign-in (0600 JSON; `autobrowse creds set <site>` writes it).
# CREDENTIALS_FILE=~/.config/autobrowse/credentials.json
# keychain (macOS: AES-256-GCM, key in the login Keychain) or none (containers: credentials from env).
# CREDENTIALS_CIPHER=keychain
# Inbox that receives email one-time codes when the credential does not name one.
# CODES_INBOX=
# A phone paired with this Mac (E.164). SMS codes are read from Messages (Text Message Forwarding
# on, Full Disk Access for the terminal). `autobrowse setup` checks both.
# PHONE_NUMBER=
# Guards a person still approves: all, none, or a comma list of purchase, password, irreversible.
# GUARDS=all
# Where minted credentials go: envfile (this file, upserted) or ssm (`autobrowse env`).
# SECRET_SINK=envfile
# ENV_FILE=.env
# Let proposals be explored, saved and compiled with nobody clicking (guards still hold).
# AUTO_BUILD=false
# A compiled step that fails: the agent finishes it, the step is rewritten, the flow proven again.
# AUTO_HEAL=false

# ── Tier 2: durable runs. Needs a local Restate (`brew install restatedev/tap/restate`). ───
# `autobrowse setup --tier 2` writes these; `autobrowse worker` then registers itself.

# RESTATE_INGRESS_URL=http://localhost:8080
# RESTATE_ADMIN_URL=http://localhost:9070
# RESTATE_ENDPOINT_URL=http://localhost:9081
# RESTATE_PORT=9081
