{
  "name": "@wrenautomation/autobrowse",
  "version": "0.3.0",
  "description": "Browser and account automation: recorded flows where no API exists, official API shapes where one does, a person in the loop for money, accounts and consent.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wrenautomation/autobrowse.git"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sites": {
      "types": "./dist/sites/index.d.ts",
      "import": "./dist/sites/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./do": {
      "types": "./dist/do/index.d.ts",
      "import": "./dist/do/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    },
    "./flows": {
      "types": "./dist/browser/flows/index.d.ts",
      "import": "./dist/browser/flows/index.js"
    },
    "./llm": {
      "types": "./dist/llm/index.d.ts",
      "import": "./dist/llm/index.js"
    },
    "./layout": {
      "types": "./dist/browser/layout.d.ts",
      "import": "./dist/browser/layout.js"
    }
  },
  "bin": {
    "autobrowse": "dist/app/cli.js"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "biome check . && sh map/_meta/rebuild.sh --check",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc -p ui --noEmit",
    "build": "tsc",
    "build:check": "tsc && node scripts/build-check.mjs",
    "test": "vitest run",
    "worker": "tsx src/app/main.ts",
    "desk": "tsx src/app/desk.ts",
    "autobrowse": "tsx src/app/cli.ts",
    "record": "tsx src/app/cli-record.ts",
    "gates": "pnpm lint && pnpm typecheck && pnpm test",
    "ui:dev": "vite --config ui/vite.config.ts ui",
    "ui:build": "vite build --config ui/vite.config.ts ui",
    "test:live": "LIVE=1 vitest run test/live.test.ts",
    "prepublishOnly": "rm -rf dist && pnpm build:check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@restatedev/restate-sdk-testcontainers": "1.17.1",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "3.1136.0",
    "@aws-sdk/client-s3": "3.1136.0",
    "@aws-sdk/client-ssm": "3.1136.0",
    "@hono/node-server": "2.1.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@restatedev/restate-sdk": "1.17.1",
    "@restatedev/restate-sdk-clients": "1.17.1",
    "@restatedev/restate-sdk-tunnel": "1.17.1",
    "@sentry/node": "10.75.0",
    "commander": "15.0.0",
    "credvault": "0.11.0",
    "hono": "4.13.8",
    "patchright": "1.63.0",
    "pino": "10.3.1",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "smol-toml": "1.8.0",
    "tsx": "4.23.13",
    "zod": "4.6.5"
  },
  "license": "PolyForm-Strict-1.0.0"
}
