{
  "name": "google-cloud-oauth-client",
  "site": "google",
  "description": "In a Google Cloud project: enable an API, configure the OAuth consent screen (external, testing), create a Web OAuth client with a loopback redirect and keep its id and secret, add the account as a test user",
  "fields": [
    {
      "key": "project",
      "label": "Google Cloud project id",
      "example": "wren-509223"
    },
    {
      "key": "api",
      "label": "API to enable (service name)",
      "example": "youtube.googleapis.com"
    },
    {
      "key": "appName",
      "label": "App name on the consent screen",
      "example": "Wren Automation"
    },
    {
      "key": "email",
      "label": "The account's email (support contact and test user)",
      "example": "jinwilliam.jin@gmail.com"
    },
    {
      "key": "clientName",
      "label": "OAuth client name",
      "example": "autobrowse"
    },
    {
      "key": "redirectUri",
      "label": "Authorized redirect URI",
      "example": "http://127.0.0.1:9400/oauth/callback"
    }
  ],
  "secrets": [],
