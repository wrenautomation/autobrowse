# The box's env, pushed to the store by `pnpm autobrowse env push --from deploy/prod.env`. Never committed with values.
# Restate Cloud (the wren env): ingress + Full-role key, then the tunnel identity.
RESTATE_INGRESS_URL=https://<env-id>.env.us.restate.cloud:8080
RESTATE_AUTH_TOKEN=
RESTATE_TUNNEL_NAME=autobrowse-v1
RESTATE_ENVIRONMENT_ID=env_
RESTATE_CLOUD_REGION=us
RESTATE_IDENTITY_KEY=publickeyv1_
# Required: the UI binds off loopback inside the container.
UI_TOKEN=
# Browser: local (Chromium in the image, headless) or browserbase (+ keys).
BROWSER=local
BROWSER_HEADLESS=true
PACE=human
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Vendors and channels, same names as .env.example. Site credentials as AUTOBROWSE_CRED_<SITE>_*.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
GOOGLE_SERVICE_ACCOUNT=~/.config/wren/wren-sender.json
GOOGLE_ADMIN_USER=
DMARC_RUA=
NOTIFY_TO=
NOTIFY_FROM=
LINQ_API_KEY=
LINQ_NUMBER=
LINQ_TO=
LINQ_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
CODES_INBOX=
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_DAILY_TOKENS=3000000
SENTRY_DSN=
SENTRY_ENVIRONMENT=prod
EVALUATE_EVERY_HOURS=0
AUTO_BUILD=false
GUARDS=all
CREDENTIALS_CIPHER=none
AUTOBROWSE_CRED_CLOUDFLARE_USERNAME=
AUTOBROWSE_CRED_CLOUDFLARE_PASSWORD=
AUTOBROWSE_CRED_CLOUDFLARE_TOTP_SECRET=
AUTOBROWSE_CRED_GOOGLE_ADMIN_USERNAME=
AUTOBROWSE_CRED_GOOGLE_ADMIN_PASSWORD=
AUTOBROWSE_CRED_GOOGLE_ADMIN_TOTP_SECRET=
