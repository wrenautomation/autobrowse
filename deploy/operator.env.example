# Operator and fleet settings: one person or company running autobrowse for many
# accounts, on several machines, with Restate Cloud, DNS, rosters and SMS numbers.
# A single developer needs none of this (see .env.example). Append what you use to .env.

# The default owner's name (key rows carry it); `me` when unset.
AUTOBROWSE_OPERATOR=
# The shared credential store (SSM): every read asks it first. Off when unset.
CREDENTIALS_SHARED=ssm
# The owners role (terraform output owner_role_arn) a non-default owner assumes.
AUTOBROWSE_OWNER_ROLE_ARN=

RESTATE_AUTH_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
GOOGLE_SERVICE_ACCOUNT=~/.config/autobrowse/service-account.json
GOOGLE_ADMIN_USER=
ROSTER_SSM_PARAM=
AWS_REGION=us-east-1
NOTIFY_TO=
NOTIFY_FROM=
DMARC_RUA=
GITHUB_TOKEN=
WREN_REPO=
BROWSER=local
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Sites that run in your own browser (opt-in; see README "Your own browser")
OWN_BROWSER=
OWN_BROWSER_SITES=
# Sentry: failed runs, failed steps and crashes become issues, tagged workflow/key/step. Off when unset.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
# Every N hours the evaluator reads failures, sessions and recordings and messages what deserves a workflow; 0 = off.
EVALUATE_EVERY_HOURS=0
# On EC2 only: stop the machine after N idle minutes (no run, flow, site call, agent session or UI request); 0 = never.
IDLE_STOP_MINUTES=0
# Linq (iMessage from a number we own, no Mac): key + our number; LINQ_TO = the operator (defaults to PHONE_NUMBER).
# Register a webhook at <UI>/hooks/linq for message.received and put its signing secret here.
LINQ_API_KEY=
LINQ_NUMBER=
LINQ_TO=
LINQ_WEBHOOK_SECRET=
# SMS one-time codes: a Twilio number we own. All three or none.
# A personal phone paired with this Mac (E.164). SMS codes are read from Messages'
# database (Text Message Forwarding on, Full Disk Access for the terminal app), notes
# go back over iMessage. `autobrowse setup` checks both and opens the pane.
# Which of your accounts is for what, for a box with no ~/.config/autobrowse/accounts.json (`autobrowse accounts push` writes it).
AUTOBROWSE_ACCOUNTS=
# The Workspace domain the service account is delegated for (gmail.modify, the exact scope): those inboxes read codes without a consent.
GOOGLE_WORKSPACE_DOMAIN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
# Per-site credentials as env (a k8s Secret; also fine in this file). Site names uppercased, dashes to underscores.
AUTOBROWSE_CRED_CLOUDFLARE_USERNAME=
AUTOBROWSE_CRED_CLOUDFLARE_PASSWORD=
AUTOBROWSE_CRED_CLOUDFLARE_TOTP_SECRET=
AUTOBROWSE_CRED_GOOGLE_ADMIN_USERNAME=
AUTOBROWSE_CRED_GOOGLE_ADMIN_PASSWORD=
AUTOBROWSE_CRED_GOOGLE_ADMIN_TOTP_SECRET=
WEBHOOK_URL=
WEBHOOK_TOKEN=
# hosts a run's x-feed-url may name, comma-separated (*.example.com for any under it); bearer on each post
FEED_HOSTS=
FEED_TOKEN=
MEMORY=none
BACKBOARD_API_KEY=
BACKBOARD_ASSISTANT=autobrowse
RESTATE_ENDPOINT_URL=
# Restate Cloud with no inbound port: the worker dials the env's tunnel and registers the URL it gets.
# All four together (RESTATE_AUTH_TOKEN is the Full-role key). RESTATE_IDENTITY_KEY alone also locks a plain listener to one env.
RESTATE_TUNNEL_NAME=
RESTATE_ENVIRONMENT_ID=
RESTATE_CLOUD_REGION=
RESTATE_IDENTITY_KEY=
